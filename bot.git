        "Вы можете приобрести подписку на неделю, месяц или навсегда.\n"
        "После оплаты вы получите уникальный ключ для активации программы.\n\n"
        "По всем вопросам обращайтесь к администратору.",
        reply_markup=get_main_keyboard()
    )
    await callback.answer()

# Админские обработчики
@dp.callback_query(lambda c: c.data == "admin_give_key")
async def admin_give_key(callback: CallbackQuery, state: FSMContext):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    await callback.message.edit_text(
        "🔑 Выберите срок для выдачи ключа:",
        reply_markup=get_admin_duration_keyboard()
    )
    await state.set_state(AdminStates.selecting_key_duration)
    await callback.answer()

@dp.callback_query(lambda c: c.data.startswith("admin_") and c.data in ["admin_week", "admin_month", "admin_forever"])
async def admin_select_duration(callback: CallbackQuery, state: FSMContext):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    duration_map = {
        "admin_week": ("на неделю", 7),
        "admin_month": ("на месяц", 30),
        "admin_forever": ("навсегда", 9999)
    }
    
    duration_type, days = duration_map[callback.data]
    await state.update_data(duration_type=duration_type, days=days)
    
    await callback.message.edit_text(
        f"Введите ID пользователя, которому хотите выдать подписку на {duration_type}:"
    )
    await state.set_state(AdminStates.waiting_for_user_id)
    await callback.answer()

@dp.message(AdminStates.waiting_for_user_id)
async def process_admin_give_key(message: Message, state: FSMContext):
    if message.from_user.id != ADMIN_ID:
        return
    
    try:
        user_id = int(message.text)
    except ValueError:
        await message.answer("❌ Пожалуйста, введите корректный ID (только цифры).")
        return
    
    # Проверяем, существует ли пользователь
    user = get_user(user_id)
    if not user:
        await message.answer("❌ Пользователь с таким ID не найден в базе данных.")
        return
    
    data = await state.get_data()
    duration_type = data.get('duration_type')
    days = data.get('days')
    
    # Выдаем подписку
    update_subscription(user_id, duration_type, days)
    
    # Если подписка не навсегда, добавляем новый ключ
    if duration_type != "навсегда":
        add_new_key()
    
    await message.answer(
        f"✅ Подписка на {duration_type} успешно выдана пользователю {user_id}."
    )
    await state.clear()
    
    # Возвращаемся в админ-панель
    await message.answer(
        "🔐 Админ-панель\n\n"
        "Выберите действие:",
        reply_markup=get_admin_keyboard()
    )

@dp.callback_query(lambda c: c.data == "admin_take_key")
async def admin_take_key(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    subscribed_users = get_subscribed_users()
    if not subscribed_users:
        await callback.message.edit_text(
            "📭 Нет пользователей с активной подпиской.",
            reply_markup=get_admin_keyboard()
        )
        await callback.answer()
        return
    
    # Создаем клавиатуру со списком пользователей
    keyboard = []
    for user in subscribed_users:
        user_id, username, first_name, sub_type, sub_end = user
        display_name = f"{first_name} (@{username})" if username else f"{first_name} (ID: {user_id})"
        keyboard.append([InlineKeyboardButton(
            text=f"🆔 {user_id} - {sub_type}",
            callback_data=f"take_key_{user_id}"
        )])
    
    keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="back_to_admin")])
    
    await callback.message.edit_text(
        "📋 Выберите пользователя, у которого нужно забрать ключ:",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=keyboard)
    )
    await callback.answer()

@dp.callback_query(lambda c: c.data.startswith("take_key_"))
async def process_take_key(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    user_id = int(callback.data.split("_")[2])
    
    # Забираем подписку
    update_subscription(user_id, None, 0)
    
    await callback.message.edit_text(
        f"✅ Подписка у пользователя {user_id} успешно отобрана.",
        reply_markup=get_admin_keyboard()
    )
    await callback.answer()

@dp.callback_query(lambda c: c.data == "admin_ban_user")
async def admin_ban_user(callback: CallbackQuery, state: FSMContext):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    await callback.message.edit_text(
        "🚫 Введите ID пользователя, которого хотите забанить:"
    )
    await state.set_state(AdminStates.waiting_for_ban_user_id)
    await callback.answer()

@dp.message(AdminStates.waiting_for_ban_user_id)
async def process_admin_ban(message: Message, state: FSMContext):
    if message.from_user.id != ADMIN_ID:
        return
    
    try:
        user_id = int(message.text)
    except ValueError:
        await message.answer("❌ Пожалуйста, введите корректный ID (только цифры).")
        return
    
    # Проверяем, существует ли пользователь
    user = get_user(user_id)
    if not user:
        await message.answer("❌ Пользователь с таким ID не найден.")
        return
    
    ban_user(user_id)
    await message.answer(f"✅ Пользователь {user_id} успешно забанен.")
    await state.clear()
    
    # Возвращаемся в админ-панель
    await message.answer(
        "🔐 Админ-панель\n\n"
        "Выберите действие:",
        reply_markup=get_admin_keyboard()
    )

@dp.callback_query(lambda c: c.data == "admin_unban_user")
async def admin_unban_user(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    banned_users = get_banned_users()
    if not banned_users:
        await callback.message.edit_text(
            "📭 Нет забаненных пользователей.",
            reply_markup=get_admin_keyboard()
        )
        await callback.answer()
        return
    
    # Создаем клавиатуру со списком забаненных
    keyboard = []
    for user in banned_users:
        user_id, username, first_name = user
        display_name = f"{first_name} (@{username})" if username else f"{first_name} (ID: {user_id})"
        keyboard.append([InlineKeyboardButton(
            text=f"🆔 {user_id} - {display_name[:20]}",
            callback_data=f"unban_{user_id}"
        )])
    
    keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="back_to_admin")])
    
    await callback.message.edit_text(
        "📋 Выберите пользователя для разбана:",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=keyboard)
    )
    await callback.answer()

@dp.callback_query(lambda c: c.data.startswith("unban_"))
async def process_unban(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    user_id = int(callback.data.split("_")[1])
    unban_user(user_id)
    
    await callback.message.edit_text(
        f"✅ Пользователь {user_id} успешно разбанен.",
        reply_markup=get_admin_keyboard()
    )
    await callback.answer()

@dp.callback_query(lambda c: c.data == "admin_list_users")
async def admin_list_users(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    users = get_all_users()
    if not users:
        await callback.message.edit_text(
            "📭 Нет зарегистрированных пользователей.",
            reply_markup=get_admin_keyboard()
        )
        await callback.answer()
        return
    
    text = "📋 Список пользователей:\n\n"
    for user in users[:20]:  # Показываем первых 20
        user_id, username, first_name, sub_type, sub_end = user
        display_name = f"{first_name} (@{username})" if username else f"{first_name}"
        text += f"🆔 {user_id}: {display_name}\n"
        text += f"   📋 Подписка: {sub_type or 'Нет'}\n"
        if sub_end:
            text += f"   ⏳ До: {sub_end}\n"
        text += "\n"
    
    if len(users) > 20:
        text += f"И ещё {len(users) - 20} пользователей..."
    
    await callback.message.edit_text(text, reply_markup=get_admin_keyboard())
    await callback.answer()

@dp.callback_query(lambda c: c.data == "admin_list_banned")
async def admin_list_banned(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    banned = get_banned_users()
    if not banned:
        await callback.message.edit_text(
            "📭 Нет забаненных пользователей.",
            reply_markup=get_admin_keyboard()
        )
        await callback.answer()
        return
    
    text = "⛔ Список забаненных пользователей:\n\n"
    for user in banned:
        user_id, username, first_name = user
        display_name = f"{first_name} (@{username})" if username else f"{first_name}"
        text += f"🆔 {user_id}: {display_name}\n"
    
    await callback.message.edit_text(text, reply_markup=get_admin_keyboard())
    await callback.answer()

@dp.callback_query(lambda c: c.data == "admin_list_subscribed")
async def admin_list_subscribed(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    subscribed = get_subscribed_users()
    if not subscribed:
        await callback.message.edit_text(
            "📭 Нет пользователей с подпиской.",
            reply_markup=get_admin_keyboard()
        )
        await callback.answer()
        return
    
    text = "🌟 Список пользователей с подпиской:\n\n"
    for user in subscribed[:20]:
        user_id, username, first_name, sub_type, sub_end = user
        display_name = f"{first_name} (@{username})" if username else f"{first_name}"
        text += f"🆔 {user_id}: {display_name}\n"
        text += f"   📋 Подписка: {sub_type}\n"
        if sub_end:
            text += f"   ⏳ До: {sub_end}\n"
        text += "\n"
    
    if len(subscribed) > 20:
        text += f"И ещё {len(subscribed) - 20} пользователей..."
    
    await callback.message.edit_text(text, reply_markup=get_admin_keyboard())
    await callback.answer()

# Запуск бота
async def main():
    # Инициализация базы данных
    init_db()
    # Генерация ключей, если их нет
    generate_keys(5000)
    
    print("✅ Бот запущен!")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
