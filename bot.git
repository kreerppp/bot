@dp.message(ShopStates.waiting_for_nft_add_name)
async def process_nft_name(message: types.Message, state: FSMContext):
    await state.update_data(nft_name=message.text)
    await state.set_state(ShopStates.waiting_for_nft_add_number)
    await message.answer("📝 Введите номер NFT:")

@dp.message(ShopStates.waiting_for_nft_add_number)
async def process_nft_number(message: types.Message, state: FSMContext):
    await state.update_data(nft_number=message.text)
    await state.set_state(ShopStates.waiting_for_nft_add_price)
    await message.answer("💰 Введите стоимость NFT в звездах:")

@dp.message(ShopStates.waiting_for_nft_add_price)
async def process_nft_price(message: types.Message, state: FSMContext):
    try:
price = int(message.text)
        data = await state.get_data()
        
        cursor.execute(
            "INSERT INTO nfts (name, number, price) VALUES (?, ?, ?)",
            (data['nft_name'], data['nft_number'], price)
        )
        conn.commit()
        
        await message.answer(
            f"✅ NFT успешно добавлен!\n"
            f"Название: {data['nft_name']}\n"
            f"Номер: {data['nft_number']}\n"
            f"Цена: {price} ⭐️",
            reply_markup=get_admin_keyboard()
        )
        await state.clear()
    except ValueError:
        await message.answer("❌ Пожалуйста, введите число!")

