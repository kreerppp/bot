# Обработчики команд
@dp.message(Command("start"))
async def start_command(message: Message):
    user_id = message.from_user.id
    username = message.from_user.username
    first_name = message.from_user.first_name
    
    # Добавляем пользователя в базу
    add_user(user_id, username, first_name)
    
    # Проверяем, не забанен ли пользователь
    user = get_user(user_id)
    if user and user[5]:  # is_banned = TRUE
        await message.answer("⛔ Вы забанены и не можете использовать бота.")
        return
    
    await message.answer(
        "👋 Привет! Я бот для покупки ключей в программу Crazy Info.\n\n"
        "Выбери нужную тебе категорию:",
        reply_markup=get_main_keyboard()
    )

@dp.message(Command("adminpanel"))
async def admin_panel(message: Message):
