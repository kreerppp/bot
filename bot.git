    btn5 = types.InlineKeyboardButton("👑 Топ игроков", callback_data="top")
    btn6 = types.InlineKeyboardButton("⚙️ Админ-панель", callback_data="admin")
    keyboard.add(btn1, btn2)
    keyboard.add(btn3, btn4)
    keyboard.add(btn5, btn6)
    return keyboard

