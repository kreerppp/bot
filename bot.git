@dp.message(ShopStates.waiting_for_username_purchase)
async def process_username_purchase(message: types.Message, state: FSMContext):
    await state.update_data(shuza_username=message.text)
    
    cursor.execute("SELECT id, username, price FROM usernames")
    usernames = cursor.fetchall()
    
    if not usernames:
        await message.answer("Нет доступных username")
        return
    
    keyboard = []
    for user in usernames:
        keyboard.append([InlineKeyboardButton(
            text=f"@{user[1]} - {user[2]} ⭐️",
            callback_data=f"select_username_{user[0]}"
        )])
    keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="shop")])
    
    await state.set_state(ShopStates.waiting_for_username_selection)
    await message.answer(
        "👤 Выберите username:",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=keyboard)
    )
@dp.callback_query(F.data.startswith("select_username_"))
async def select_username_handler(callback: types.CallbackQuery, state: FSMContext):
    user_id = int(callback.data.split("_")[2])
    cursor.execute("SELECT username, price FROM usernames WHERE id = ?", (user_id,))
    user_data = cursor.fetchone()
    data = await state.get_data()
    shuza_username = data.get('shuza_username')
    
    if user_data:
        await bot.send_invoice(
            chat_id=callback.from_user.id,
            title=f"Username: @{user_data[0]}",
            description=f"Покупка username @{user_data[0]} для пользователя {shuza_username}",
            payload=f"username_{user_id}_{shuza_username}",
            provider_token="",
            currency="XTR",
            prices=[LabeledPrice(label=f"Username @{user_data[0]}", amount=user_data[1])]
        )
    await state.clear()
    await callback.message.delete()
    await callback.answer()

# Обработка платежей
@dp.pre_checkout_query()
async def process_pre_checkout_query(pre_checkout_query: PreCheckoutQuery):
    await bot.answer_pre_checkout_query(pre_checkout_query.id, ok=True)

@dp.message(F.successful_payment)
async def process_successful_payment(message: types.Message):
    payment = message.successful_payment
    payload = payment.invoice_payload
    user_id = message.from_user.id
    
    # Парсинг payload
    parts = payload.split("_")
    item_type = parts[0]
    
    if item_type == "stars":
        amount = parts[1]
        username = parts[2]
        cursor.execute(
            "INSERT INTO purchases (user_id, username, item_type, item_name, amount) VALUES (?, ?, ?, ?, ?)",
            (user_id, username, "stars", f"{amount} звезд", int(amount))
        )
        await message.answer(
            f"✅ Спасибо за покупку!\n"
            f"Ожидайте выдачи {amount} звезд на аккаунт {username}.\n\n"
            f"⚠️ Если username был указан неправильно, возврат средств не производится!"
        )
    
    elif item_type == "nft":
        nft_id = parts[1]
        username = parts[2]
        cursor.execute("SELECT name FROM nfts WHERE id = ?", (nft_id,))
        nft = cursor.fetchone()
        if nft:
            cursor.execute(
                "INSERT INTO purchases (user_id, username, item_type, item_name) VALUES (?, ?, ?, ?)",
                (user_id, username, "nft", nft[0])
            )
            await message.answer(
                f"✅ Спасибо за покупку NFT {nft[0]}!\n"
                f"Скоро подарок будет выдан на аккаунт {username}.\n\n"
                f"⚠️ Если username указан неверно, возврат сделать не получится!"
            )
    
    elif item_type == "username":
        user_id_bought = parts[1]
        shuza_username = parts[2]
        cursor.execute("SELECT username FROM usernames WHERE id = ?", (user_id_bought,))
        user_data = cursor.fetchone()
        if user_data:
            cursor.execute(
                "INSERT INTO purchases (user_id, username, item_type, item_name) VALUES (?, ?, ?, ?)",
                (user_id, shuza_username, "username", user_data[0])
            )
            await message.answer(
                f"✅ Спасибо за покупку username @{user_data[0]}!\n"
                f"Username будет выдан на аккаунт {shuza_username}.\n\n"
                f"⚠️ Если username указан неверно, возврат сделать не получится!"
            )
    
    conn.commit()

# Админ панель
@dp.callback_query(F.data == "admin_panel")
async def admin_panel_handler(callback: types.CallbackQuery):
    if not is_admin(callback.from_user.id):
        await callback.answer("У вас нет доступа!", show_alert=True)
        return
    
    await callback.message.edit_text(
        "👑 Админ панель:",
        reply_markup=get_admin_keyboard()
    )
    await callback.answer()
@dp.callback_query(F.data == "toggle_bot")
async def toggle_bot_handler(callback: types.CallbackQuery):
    if not is_admin(callback.from_user.id):
        return
    
    cursor.execute("SELECT is_active FROM bot_status WHERE id = 1")
    current_status = cursor.fetchone()[0]
    new_status = 0 if current_status == 1 else 1
    cursor.execute("UPDATE bot_status SET is_active = ? WHERE id = 1", (new_status,))
    conn.commit()
    
    status_text = "включен" if new_status == 1 else "выключен"
    await callback.message.edit_text(
        f"🔴 Бот {status_text} для обычных пользователей.",
        reply_markup=get_admin_keyboard()
    )
    await callback.answer()

@dp.callback_query(F.data == "view_purchases")
async def view_purchases_handler(callback: types.CallbackQuery, page=0):
    if not is_admin(callback.from_user.id):
        return
    
    limit = 10
    offset = page * limit
    
    cursor.execute("SELECT COUNT(*) FROM purchases")
    total = cursor.fetchone()[0]
    
    cursor.execute(
        "SELECT id, user_id, username, item_type, item_name, amount, status FROM purchases LIMIT ? OFFSET ?",
        (limit, offset)
    )
    purchases = cursor.fetchall()
    
    if not purchases:
        await callback.message.edit_text(
            "📊 Нет покупок.",
            reply_markup=get_admin_keyboard()
        )
        return
    
    text = "📊 <b>Список покупок:</b>\n\n"
    for purchase in purchases:
        text += f"ID: {purchase[0]}\n"
        text += f"Пользователь: {purchase[1]}\n"
        text += f"Username: {purchase[2]}\n"
        text += f"Тип: {purchase[3]}\n"
        text += f"Товар: {purchase[4]}\n"
        if purchase[5]:
            text += f"Количество: {purchase[5]}\n"
        text += f"Статус: {purchase[6]}\n"
        text += "➖➖➖➖➖➖➖➖\n"
    
    # Пагинация
    keyboard = []
    nav_buttons = []
    
    if page > 0:
        nav_buttons.append(InlineKeyboardButton(
            text="⬅️ Назад",
            callback_data=f"purchases_page_{page-1}"
        ))
    
    if (page + 1) * limit < total:
        nav_buttons.append(InlineKeyboardButton(
            text="Вперед ➡️",
            callback_data=f"purchases_page_{page+1}"
        ))
    
    if nav_buttons:
        keyboard.append(nav_buttons)
    
    keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="admin_panel")])
    
    await callback.message.edit_text(
        text,
        reply_markup=InlineKeyboardMarkup(inline_keyboard=keyboard)
    )
    await callback.answer()

@dp.callback_query(F.data.startswith("purchases_page_"))
async def purchases_page_handler(callback: types.CallbackQuery):
    page = int(callback.data.split("_")[2])
    await view_purchases_handler(callback, page)

@dp.callback_query(F.data == "add_nft")
async def add_nft_handler(callback: types.CallbackQuery, state: FSMContext):
