@dp.message(ShopStates.waiting_for_username_price)
async def process_username_price(message: types.Message, state: FSMContext):
    try:
        price = int(message.text)
        data = await state.get_data()
        
        cursor.execute(
            "INSERT INTO usernames (username, price) VALUES (?, ?)",
            (data['username_to_add'], price)
        )
        conn.commit()
        
        await message.answer(
            f"✅ Username успешно добавлен!\n"
            f"Username: @{data['username_to_add']}\n"
            f"Цена: {price} ⭐️",
            reply_markup=get_admin_keyboard()
        )
        await state.clear()
    except ValueError:
        await message.answer("❌ Пожалуйста, введите число!")

@dp.callback_query(F.data == "add_admin")
async def add_admin_handler(callback: types.CallbackQuery, state: FSMContext):
    if not is_admin(callback.from_user.id):
        return
    
    await state.set_state(ShopStates.waiting_for_admin_add)
    await callback.message.edit_text(
        "📝 Введите ID пользователя для добавления в админы.\n"
        "ID можно узнать в боте @userinfo3bot"
    )
    await callback.answer()

@dp.message(ShopStates.waiting_for_admin_add)
async def process_admin_add(message: types.Message, state: FSMContext):
    try:
        new_admin_id = int(message.text)
        cursor.execute("INSERT OR IGNORE INTO admins (user_id) VALUES (?)", (new_admin_id,))
        conn.commit()
        
        await message.answer(
            f"✅ Пользователь {new_admin_id} добавлен в админы!",
            reply_markup=get_admin_keyboard()
        )
        await state.clear()
    except ValueError:
        await message.answer("❌ Пожалуйста, введите корректный ID!")

@dp.callback_query(F.data == "remove_admin")
async def remove_admin_handler(callback: types.CallbackQuery):
    if not is_admin(callback.from_user.id):
        return
    
    cursor.execute("SELECT user_id FROM admins")
    admins = cursor.fetchall()
    
    if len(admins) <= 1:
        await callback.answer("Нет других админов для удаления!", show_alert=True)
        return
    
    keyboard = []
    for admin in admins:
        if admin[0] != callback.from_user.id:  # Не показываем себя
            keyboard.append([InlineKeyboardButton(
                text=f"ID: {admin[0]}",
                callback_data=f"confirm_remove_admin_{admin[0]}"
            )])
    keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="admin_panel")])
    
    await callback.message.edit_text(
        "Выберите админа для удаления:",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=keyboard)
    )
    await callback.answer()
@dp.callback_query(F.data.startswith("confirm_remove_admin_"))
async def confirm_remove_admin(callback: types.CallbackQuery):
    admin_id = int(callback.data.split("_")[3])
    
    cursor.execute("DELETE FROM admins WHERE user_id = ?", (admin_id,))
    conn.commit()
    
    await callback.message.edit_text(
        f"✅ Админ {admin_id} удален!",
        reply_markup=get_admin_keyboard()
    )
    await callback.answer()

