# Админские обработчики
@dp.callback_query(lambda c: c.data == "admin_give_key")
async def admin_give_key(callback: CallbackQuery, state: FSMContext):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    await callback.message.edit_text(
        "🔑 Выберите срок для выдачи ключа:",
        reply_markup=get_admin_duration_keyboard()
    )
    await state.set_state(AdminStates.selecting_key_duration)
    await callback.answer()

@dp.callback_query(lambda c: c.data.startswith("admin_") and c.data in ["admin_week", "admin_month", "admin_forever"])
async def admin_select_duration(callback: CallbackQuery, state: FSMContext):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    duration_map = {
        "admin_week": ("на неделю", 7),
        "admin_month": ("на месяц", 30),
        "admin_forever": ("навсегда", None)
    }
    
    duration_type, days = duration_map[callback.data]
    
    if duration_type == "навсегда":
        await state.update_data(duration_type=duration_type, days=None, is_forever=True)
    else:
        await state.update_data(duration_type=duration_type, days=days, is_forever=False)
    
    await callback.message.edit_text(
        f"Введите ID пользователя, которому хотите выдать подписку {duration_type}:"
    )
    await state.set_state(AdminStates.waiting_for_user_id)
    await callback.answer()

@dp.callback_query(lambda c: c.data == "admin_custom")
async def admin_custom_duration(callback: CallbackQuery, state: FSMContext):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    await callback.message.edit_text(
        "⏱️ Введите срок в формате:\n\n"
        "1s - 1 секунда\n"
        "5m - 5 минут\n"
        "1h - 1 час\n"
        "2d - 2 дня\n"
        "1w - 1 неделя\n"
        "1mo - 1 месяц\n\n"
        "Пример: 30m, 2h, 7d"
    )
    await state.set_state(AdminStates.waiting_for_custom_duration)
    await callback.answer()

@dp.message(AdminStates.waiting_for_custom_duration)
async def process_custom_duration(message: Message, state: FSMContext):
    if message.from_user.id != ADMIN_ID:
        return
    
    duration_str = message.text.lower().strip()
    
    # Парсим ввод
    import re
    match = re.match(r'^(\d+)([smhdwmo]+)$', duration_str)
    
    if not match:
        await message.answer(
            "❌ Неверный формат. Используйте:\n"
            "1s, 5m, 2h, 3d, 1w, 1mo\n\n"
            "Попробуйте снова:"
        )
        return
    
    value = int(match.group(1))
    unit = match.group(2)
    
    # Конвертируем в секунды
    seconds = 0
    if unit == 's':
        seconds = value
    elif unit == 'm':
        seconds = value * 60
    elif unit == 'h':
        seconds = value * 3600
    elif unit == 'd':
        seconds = value * 86400
    elif unit == 'w':
        seconds = value * 604800
    elif unit == 'mo':
        seconds = value * 2592000  # 30 дней
    
    if seconds <= 0:
        await message.answer("❌ Срок должен быть больше 0. Попробуйте снова:")
        return
    
    # Сохраняем в состояние
    await state.update_data(
        duration_type=f"на {duration_str}",
        custom_seconds=seconds,
        is_forever=False
    )
    
    await message.answer(
        f"✅ Установлен срок: {duration_str}\n\n"
        f"Теперь введите ID пользователя, которому хотите выдать ключ:"
    )
    await state.set_state(AdminStates.waiting_for_user_id)

@dp.message(AdminStates.waiting_for_user_id)
async def process_admin_give_key(message: Message, state: FSMContext):
    if message.from_user.id != ADMIN_ID:
        return
    
    try:
        user_id = int(message.text)
    except ValueError:
        await message.answer("❌ Пожалуйста, введите корректный ID (только цифры).")
        return
    
    # Проверяем, существует ли пользователь
    user = get_user(user_id)
    if not user:
        await message.answer("❌ Пользователь с таким ID не найден в базе данных.\n\nПользователь должен хотя бы раз запустить бота командой /start")
        return
    
    data = await state.get_data()
    duration_type = data.get('duration_type')
    is_forever = data.get('is_forever', False)
    custom_seconds = data.get('custom_seconds')
    
    # Вычисляем дату окончания
    end_datetime = None
    if not is_forever:
        if custom_seconds:
            end_datetime = (datetime.now() + timedelta(seconds=custom_seconds)).strftime('%Y-%m-%d %H:%M:%S.%f')
        else:
            days = data.get('days')
            if days:
                end_datetime = (datetime.now() + timedelta(days=days)).strftime('%Y-%m-%d %H:%M:%S.%f')
    else:
        duration_type = "навсегда"
    
    # Получаем ключ для пользователя
    user_key = get_key()
    
    # Выдаем подписку с ключом
    update_subscription(user_id, duration_type, end_datetime, user_key)
    
    await message.answer(
        f"✅ Подписка на {duration_type} успешно выдана пользователю {user_id}.\n"
        f"🔑 Ключ: <code>{user_key}</code>\n\n"
        f"Пользователь может посмотреть ключ в профиле.",
        parse_mode="HTML"
    )
    await state.clear()
    
    # Возвращаемся в админ-панель
    await message.answer(
        "🔐 Админ-панель\n\n"
        "Выберите действие:",
        reply_markup=get_admin_keyboard()
    )

@dp.callback_query(lambda c: c.data == "admin_take_key")
async def admin_take_key(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    subscribed_users = get_subscribed_users()
    if not subscribed_users:
        await callback.message.edit_text(
            "📭 Нет пользователей с активной подпиской.",
            reply_markup=get_admin_keyboard()
        )
        await callback.answer()
        return
    
    # Создаем клавиатуру со списком пользователей
    keyboard = []
    for user in subscribed_users[:20]:
        user_id, username, first_name, sub_type, sub_end = user
        display_name = f"{first_name} (@{username})" if username else f"{first_name} (ID: {user_id})"
        keyboard.append([InlineKeyboardButton(
            text=f"🆔 {user_id} - {sub_type}",
            callback_data=f"take_key_{user_id}"
        )])
    
    if len(subscribed_users) > 20:
        keyboard.append([InlineKeyboardButton(
            text=f"📊 Всего {len(subscribed_users)} пользователей",
            callback_data="noop"
        )])
    
    keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="back_to_admin")])
    
    await callback.message.edit_text(
        "📋 Выберите пользователя, у которого нужно забрать ключ:",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=keyboard)
    )
    await callback.answer()

@dp.callback_query(lambda c: c.data.startswith("take_key_"))
async def process_take_key(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    user_id = int(callback.data.split("_")[2])
    
    # Забираем подписку и ключ
    update_subscription(user_id, None, None, None)
    
    await callback.message.edit_text(
        f"✅ Подписка у пользователя {user_id} успешно отобрана.",
        reply_markup=get_admin_keyboard()
    )
    await callback.answer()

@dp.callback_query(lambda c: c.data == "admin_ban_user")
async def admin_ban_user(callback: CallbackQuery, state: FSMContext):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    await callback.message.edit_text(
        "🚫 Введите ID пользователя, которого хотите забанить:"
    )
    await state.set_state(AdminStates.waiting_for_ban_user_id)
    await callback.answer()

@dp.message(AdminStates.waiting_for_ban_user_id)
async def process_admin_ban(message: Message, state: FSMContext):
    if message.from_user.id != ADMIN_ID:
        return
    
    try:
        user_id = int(message.text)
    except ValueError:
        await message.answer("❌ Пожалуйста, введите корректный ID (только цифры).")
        return
    
    # Проверяем, существует ли пользователь
    user = get_user(user_id)
    if not user:
        await message.answer("❌ Пользователь с таким ID не найден.")
        return
    
    ban_user(user_id)
    await message.answer(f"✅ Пользователь {user_id} успешно забанен.")
    await state.clear()
    
    # Возвращаемся в админ-панель
    await message.answer(
        "🔐 Админ-панель\n\n"
        "Выберите действие:",
        reply_markup=get_admin_keyboard()
    )

@dp.callback_query(lambda c: c.data == "admin_unban_user")
async def admin_unban_user(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    banned_users = get_banned_users()
    if not banned_users:
        await callback.message.edit_text(
            "📭 Нет забаненных пользователей.",
            reply_markup=get_admin_keyboard()
        )
        await callback.answer()
        return
    
    # Создаем клавиатуру со списком забаненных
    keyboard = []
    for user in banned_users[:20]:
        user_id, username, first_name = user
        display_name = f"{first_name} (@{username})" if username else f"{first_name} (ID: {user_id})"
        keyboard.append([InlineKeyboardButton(
            text=f"🆔 {user_id} - {display_name[:20]}",
            callback_data=f"unban_{user_id}"
        )])
    
    if len(banned_users) > 20:
        keyboard.append([InlineKeyboardButton(
            text=f"📊 Всего {len(banned_users)} забаненных",
            callback_data="noop"
        )])
    
    keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="back_to_admin")])
    
    await callback.message.edit_text(
        "📋 Выберите пользователя для разбана:",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=keyboard)
    )
    await callback.answer()

@dp.callback_query(lambda c: c.data.startswith("unban_"))
async def process_unban(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    user_id = int(callback.data.split("_")[1])
    unban_user(user_id)
    
    await callback.message.edit_text(
        f"✅ Пользователь {user_id} успешно разбанен.",
        reply_markup=get_admin_keyboard()
    )
    await callback.answer()

@dp.callback_query(lambda c: c.data == "admin_list_users")
async def admin_list_users(callback: CallbackQuery):
    if callback.from_user.id != ADMIN_ID:
        await callback.answer("⛔ У вас нет доступа.")
        return
    
    users = get_all_users()
    if not users:
        await callback.message.edit_text(
            "📭 Нет зарегистрированных пользователей.",
            reply_markup=get_admin_keyboard()
        )
        await callback.answer()
        return
    
    text = "📋 Список пользователей:\n\n"
    for user in users[:20]:
        user_id, username, first_name, sub_type, sub_end = user
        display_name = f"{first_name} (@{username})" if username else f"{first_name}"
        text += f"🆔 {user_id}: {display_name}\n"
        text += f"   📋 Подписка: {sub_type or 'Нет'}\n"
        if sub_end and sub_type != "навсегда":
            try:
                end_date = datetime.strptime(sub_end, '%Y-%m-%d %H:%M:%S.%f')
                if end_date > datetime.now():
                    text += f"   ⏳ До: {end_date.strftime('%Y-%m-%d %H:%M')}\n"
                else:
                    text += f"   ⏳ Истекла\n"
            except:
                text += f"   ⏳ До: {sub_end}\n"
        elif sub_type == "навсегда":
            text += f"   ⏳ Навсегда\n"
        text += "\n"
    
    if len(users) > 20:
        text += f"И ещё {len(users) - 20} пользователей..."
    
    await callback.message.edit_text(text, reply_markup=get_admin_keyboard())
    await callback.answer()

