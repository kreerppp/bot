@dp.callback_query(lambda c: c.data in ["week", "month", "forever"])
async def process_payment(callback: CallbackQuery):
    user_id = callback.from_user.id
    
    # Проверка на бан
    user = get_user(user_id)
    if user and user[5]:
        await callback.answer("⛔ Вы забанены!", show_alert=True)
        return
    
    prices = {
        "week": {"stars": 50, "text": "неделю", "days": 7},
        "month": {"stars": 100, "text": "месяц", "days": 30},
        "forever": {"stars": 200, "text": "навсегда", "days": 9999}
    }
    
    choice = prices[callback.data]
    
    # Создаем инвойс для оплаты звездами
    await callback.message.answer(
        f"💫 Оплатите {choice['stars']} звезд для получения ключа на {choice['text']}.",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(
                text=f"⭐ Оплатить {choice['stars']} звезд",
                pay=True
            )]
        ])
    )
    
    # В реальном боте здесь был бы процесс оплаты через Telegram Stars
    # Для демонстрации сразу выдаем ключ
    await callback.answer(f"Оплата на {choice['text']}...", show_alert=True)
    
    # Выдаем ключ
    key = get_key()
    
    # Обновляем подписку пользователя
    update_subscription(user_id, f"на {choice['text']}", choice['days'])
    
    # Добавляем новый ключ для пополнения базы
    add_new_key()
    
    await callback.message.answer(
        f"✅ Спасибо за покупку!\n"
        f"🔑 Ваш ключ на {choice['text']}:\n"
        f"<code>{key}</code>\n\n"
        f"Сохраните его, он больше не будет показан.",
        parse_mode="HTML"
    )

@dp.callback_query(lambda c: c.data == "profile")
async def show_profile(callback: CallbackQuery):
    user_id = callback.from_user.id
    user = get_user(user_id)
    
    if not user:
        await callback.answer("❌ Пользователь не найден.")
        return
    
    if user[5]:  # is_banned
        await callback.answer("⛔ Вы забанены!", show_alert=True)
        return
    
    username = user[1] or "Не указан"
    subscription_type = user[3] or "Нет подписки"
    subscription_end = user[4]
    
    profile_text = f"👤 Профиль\n\n"
    profile_text += f"🆔 ID: {user_id}\n"
    profile_text += f"👤 Ник: @{username}\n"
    profile_text += f"📋 Подписка: {subscription_type}\n"
    
    if subscription_type and subscription_type != "Нет подписки":
        if subscription_type == "навсегда":
            profile_text += f"⏳ Срок: Навсегда\n"
        elif subscription_end:
            end_date = datetime.strptime(subscription_end, '%Y-%m-%d')
            days_left = (end_date - datetime.now()).days
            if days_left > 0:
                profile_text += f"⏳ Осталось дней: {days_left}\n"
            else:
                profile_text += f"⏳ Подписка истекла\n"
    
    await callback.message.edit_text(profile_text, reply_markup=get_main_keyboard())
    await callback.answer()

@dp.callback_query(lambda c: c.data == "about")
async def about_bot(callback: CallbackQuery):
    await callback.message.edit_text(
