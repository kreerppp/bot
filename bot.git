# Состояния FSM
class AdminStates(StatesGroup):
    waiting_for_user_id = State()
    waiting_for_ban_user_id = State()
    selecting_key_duration = State()
    waiting_for_custom_duration = State()
    waiting_for_duration_value = State()

# Подключение к базе данных SQLite
def init_db():
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    
    # Таблица пользователей
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            first_name TEXT,
            subscription_type TEXT,
            subscription_end DATETIME,
            user_key TEXT,
            is_banned BOOLEAN DEFAULT FALSE,
            registered_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    
    # Таблица ключей
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS keys (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            key_value TEXT UNIQUE,
            is_used BOOLEAN DEFAULT FALSE,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    
    conn.commit()
    conn.close()

# Генерация ключей (5k+)
def generate_keys(count=5000):
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    
    # Проверяем, есть ли уже ключи
    cursor.execute('SELECT COUNT(*) FROM keys')
    if cursor.fetchone()[0] == 0:
        keys = []
        for _ in range(count):
            random_str = ''.join(random.choices(string.ascii_lowercase + string.digits, k=10))
            key = f"crazy_info-{random_str}"
            keys.append((key,))
        
        cursor.executemany('INSERT INTO keys (key_value) VALUES (?)', keys)
        conn.commit()
    
    conn.close()

# Получение ключа из базы
def get_key():
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    
    cursor.execute('SELECT key_value FROM keys WHERE is_used = FALSE LIMIT 1')
    result = cursor.fetchone()
    
    if result:
        key = result[0]
        cursor.execute('UPDATE keys SET is_used = TRUE WHERE key_value = ?', (key,))
        conn.commit()
        conn.close()
        return key
    
    # Если ключей нет, генерируем новый
    random_str = ''.join(random.choices(string.ascii_lowercase + string.digits, k=10))
    new_key = f"crazy_info-{random_str}"
    cursor.execute('INSERT INTO keys (key_value) VALUES (?)', (new_key,))
    conn.commit()
    conn.close()
    return new_key

# Добавление нового ключа
def add_new_key():
    random_str = ''.join(random.choices(string.ascii_lowercase + string.digits, k=10))
    new_key = f"crazy_info-{random_str}"
    
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    cursor.execute('INSERT INTO keys (key_value) VALUES (?)', (new_key,))
    conn.commit()
    conn.close()

# Функции для работы с пользователями
def add_user(user_id, username, first_name):
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    
    # Проверяем, существует ли пользователь
    cursor.execute('SELECT user_id FROM users WHERE user_id = ?', (user_id,))
    exists = cursor.fetchone()
    
    if not exists:
        cursor.execute('''
            INSERT INTO users (user_id, username, first_name, is_banned)
            VALUES (?, ?, ?, FALSE)
        ''', (user_id, username or "", first_name or ""))
    else:
        cursor.execute('''
            UPDATE users 
            SET username = ?, first_name = ?
            WHERE user_id = ?
        ''', (username or "", first_name or "", user_id))
    
    conn.commit()
    conn.close()

def get_user(user_id):
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    
    cursor.execute('SELECT * FROM users WHERE user_id = ?', (user_id,))
    user = cursor.fetchone()
    
    conn.close()
    return user

def update_subscription(user_id, subscription_type, end_datetime, user_key=None):
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    
    if user_key:
        cursor.execute('''
            UPDATE users 
            SET subscription_type = ?, subscription_end = ?, user_key = ?
            WHERE user_id = ?
        ''', (subscription_type, end_datetime, user_key, user_id))
    else:
        cursor.execute('''
            UPDATE users 
            SET subscription_type = ?, subscription_end = ?, user_key = NULL
            WHERE user_id = ?
        ''', (subscription_type, end_datetime, user_id))
    
    conn.commit()
    conn.close()

def get_all_users():
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    
    cursor.execute('SELECT user_id, username, first_name, subscription_type, subscription_end FROM users WHERE is_banned = FALSE')
    users = cursor.fetchall()
    
    conn.close()
    return users

def get_banned_users():
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    
    cursor.execute('SELECT user_id, username, first_name FROM users WHERE is_banned = TRUE')
    users = cursor.fetchall()
    
    conn.close()
    return users

def get_subscribed_users():
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    
    cursor.execute('''
        SELECT user_id, username, first_name, subscription_type, subscription_end 
        FROM users 
        WHERE subscription_type IS NOT NULL AND is_banned = FALSE
    ''')
    users = cursor.fetchall()
    
    conn.close()
    return users

def ban_user(user_id):
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    
    cursor.execute('UPDATE users SET is_banned = TRUE WHERE user_id = ?', (user_id,))
    conn.commit()
    conn.close()

def unban_user(user_id):
    conn = sqlite3.connect('bot_database.db')
    cursor = conn.cursor()
    
    cursor.execute('UPDATE users SET is_banned = FALSE WHERE user_id = ?', (user_id,))
    conn.commit()
    conn.close()

