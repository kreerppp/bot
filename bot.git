# Обработчики команд
@dp.message(Command("start"))
async def cmd_start(message: types.Message):
    user_id = message.from_user.id
    
    if not is_bot_active() and not is_admin(user_id):
        await message.answer("🔴 Бот приостановлен администрацией.")
        return
    
    if is_admin(user_id):
        await message.answer(
            "👋 Добро пожаловать в shuzashop!\n\n"
            "Это не официальный бот по покупке звезд, анона и т.д.\n\n"
            "Выберите действие:",
            reply_markup=get_main_keyboard(user_id)
        )
    else:
        await message.answer(
            "👋 Добро пожаловать в shuzashop!\n\n"
            "Это не официальный бот по покупке звезд, анона и т.д.\n\n"
            "Выберите действие:",
            reply_markup=get_main_keyboard(user_id)
        )

