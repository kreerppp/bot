@dp.callback_query(lambda c: c.data in ["week", "month", "forever"])
async def process_payment(callback: CallbackQuery):
    user_id = callback.from_user.id
    
    # Проверка на бан
    user = get_user(user_id)
    if user:
        if user[6]:  # is_banned
            await callback.answer("⛔ Вы забанены!", show_alert=True)
            return
    
    prices = {
        "week": {"stars": 50, "text": "неделю", "days": 7},
        "month": {"stars": 100, "text": "месяц", "days": 30},
        "forever": {"stars": 200, "text": "навсегда", "days": 9999}
    }
    
    choice = prices[callback.data]
    
    # Сразу отвечаем на callback, чтобы убрать загрузку
    await callback.answer()
    
    # Получаем ключ для пользователя
    user_key = get_key()
    
    # Вычисляем дату окончания
    end_datetime = None
    if choice['text'] != "навсегда":
        end_datetime = (datetime.now() + timedelta(days=choice['days'])).strftime('%Y-%m-%d %H:%M:%S.%f')
    
    subscription_type = f"на {choice['text']}"
    if choice['text'] == "навсегда":
        subscription_type = "навсегда"
    
    # Сохраняем подписку и ключ в профиль пользователя
    update_subscription(user_id, subscription_type, end_datetime, user_key)
    
    # Добавляем новый ключ для пополнения базы
    add_new_key()
    
    await callback.message.edit_text(
        f"✅ Спасибо за покупку!\n"
        f"🔑 Ваш ключ на {choice['text']}:\n"
        f"<code>{user_key}</code>\n\n"
        f"Сохраните его, он больше не будет показан.\n"
        f"Вы всегда можете посмотреть свой ключ в профиле.",
        parse_mode="HTML",
        reply_markup=get_main_keyboard()
    )

@dp.callback_query(lambda c: c.data == "profile")
async def show_profile(callback: CallbackQuery):
    user_id = callback.from_user.id
    user = get_user(user_id)
    
    if not user:
        await callback.answer("❌ Пользователь не найден.")
        return
    
    if user[6]:  # is_banned
        await callback.answer("⛔ Вы забанены!", show_alert=True)
        return
    
    username = user[1] or "Не указан"
    subscription_type = user[3] or "Нет подписки"
    subscription_end = user[4]
    user_key = user[5]  # user_key
    
    profile_text = f"👤 Профиль\n\n"
    profile_text += f"🆔 ID: {user_id}\n"
    profile_text += f"👤 Ник: @{username}\n"
    profile_text += f"📋 Подписка: {subscription_type}\n"
    
    if subscription_type and subscription_type != "Нет подписки":
        if subscription_type == "навсегда":
            profile_text += f"⏳ Срок: Навсегда\n"
        elif subscription_end:
            try:
                end_date = datetime.strptime(subscription_end, '%Y-%m-%d %H:%M:%S.%f')
                time_left = end_date - datetime.now()
                if time_left.total_seconds() > 0:
                    days = time_left.days
                    hours = time_left.seconds // 3600
                    minutes = (time_left.seconds % 3600) // 60
                    seconds = time_left.seconds % 60
                    
                    if days > 0:
                        profile_text += f"⏳ Осталось: {days}д {hours}ч {minutes}м\n"
                    else:
                        profile_text += f"⏳ Осталось: {hours}ч {minutes}м {seconds}с\n"
                else:
                    profile_text += f"⏳ Подписка истекла\n"
            except:
                profile_text += f"⏳ Ошибка формата даты\n"
    
    if user_key:
        profile_text += f"\n🔑 Ваш ключ:\n<code>{user_key}</code>\n"
    
    await callback.message.edit_text(profile_text, parse_mode="HTML", reply_markup=get_main_keyboard())
    await callback.answer()

