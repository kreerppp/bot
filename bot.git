# ======== ИНИЦИАЛИЗАЦИЯ БАЗЫ ДАННЫХ ========
def init_db():
    conn = sqlite3.connect('clicker.db', check_same_thread=False)
    cur = conn.cursor()
    
    # Таблица пользователей
    cur.execute('''
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            coins INTEGER DEFAULT 0,
            clicks INTEGER DEFAULT 0,
            rank INTEGER DEFAULT 1,
            passive_income INTEGER DEFAULT 1,
            click_power INTEGER DEFAULT 1,
            last_claim TIMESTAMP,
            total_coins_earned INTEGER DEFAULT 0
        )
    ''')
    
    # Таблица улучшений (у каждого пользователя свои уровни)
    cur.execute('''
        CREATE TABLE IF NOT EXISTS upgrades (
            user_id INTEGER,
            upgrade_id INTEGER,
            level INTEGER DEFAULT 0,
            PRIMARY KEY (user_id, upgrade_id)
        )
    ''')
    
    conn.commit()
    conn.close()

init_db()

# ======== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ========
def get_user(user_id):
    conn = sqlite3.connect('clicker.db', check_same_thread=False)
    cur = conn.cursor()
    cur.execute("SELECT * FROM users WHERE user_id = ?", (user_id,))
    user = cur.fetchone()
    conn.close()
    return user

def create_user_if_not_exists(user_id, username):
    conn = sqlite3.connect('clicker.db', check_same_thread=False)
    cur = conn.cursor()
    cur.execute("SELECT user_id FROM users WHERE user_id = ?", (user_id,))
    if not cur.fetchone():
        cur.execute("INSERT INTO users (user_id, username) VALUES (?, ?)", (user_id, username))
        # Создаем начальные улучшения для пользователя
        for i in range(1, 7):
            cur.execute("INSERT INTO upgrades (user_id, upgrade_id) VALUES (?, ?)", (user_id, i))
        conn.commit()
    else:
        # Обновляем username
        cur.execute("UPDATE users SET username = ? WHERE user_id = ?", (username, user_id))
        conn.commit()
    conn.close()

def get_upgrade_level(user_id, upgrade_id):
    conn = sqlite3.connect('clicker.db', check_same_thread=False)
    cur = conn.cursor()
    cur.execute("SELECT level FROM upgrades WHERE user_id = ? AND upgrade_id = ?", (user_id, upgrade_id))
    result = cur.fetchone()
    conn.close()
    return result[0] if result else 0

def update_upgrade(user_id, upgrade_id, level):
    conn = sqlite3.connect('clicker.db', check_same_thread=False)
    cur = conn.cursor()
    cur.execute("UPDATE upgrades SET level = ? WHERE user_id = ? AND upgrade_id = ?", (level, user_id, upgrade_id))
    conn.commit()
    conn.close()

def get_rank_name(rank):
    ranks = {
        1: "🥉 Новичок",
        2: "🥈 Любитель",
        3: "🥇 Профессионал",
        4: "💎 Мастер",
        5: "💎 Эксперт",
        6: "👑 Гроссмейстер",
        7: "👑 Легенда",
        8: "🔥 Император",
        9: "🔥 Бог",
        10: "🌟 Абсолют"
    }
    return ranks.get(rank, "🥉 Новичок")

def get_next_rank_cost(rank):
    return rank * 1000

def get_passive_income(user_id):
    total = 1
    for i in range(1, 7):
        level = get_upgrade_level(user_id, i)
        if i == 1: total += level * 2      # Базовый доход
        elif i == 2: total += level * 5    # Улучшенный доход
        elif i == 3: total += level * 10   # Продвинутый
        elif i == 4: total += level * 20   # Экспертный
        elif i == 5: total += level * 50   # Мастерский
        elif i == 6: total += level * 100  # Легендарный
    return total

def get_click_power(user_id):
    base = 1
    level = get_upgrade_level(user_id, 5)  # Улучшение клика
    return base + level * 2

# ======== ФУНКЦИЯ ПАССИВНОГО ДОХОДА ========
def passive_income_loop():
    while True:
        time.sleep(60)  # Каждую минуту
        conn = sqlite3.connect('clicker.db', check_same_thread=False)
        cur = conn.cursor()
        cur.execute("SELECT user_id FROM users")
        users = cur.fetchall()
        
        for user in users:
            user_id = user[0]
            income = get_passive_income(user_id)
            cur.execute("UPDATE users SET coins = coins + ?, total_coins_earned = total_coins_earned + ? WHERE user_id = ?", 
                       (income, income, user_id))
        
        conn.commit()
        conn.close()

# Запускаем поток для пассивного дохода
threading.Thread(target=passive_income_loop, daemon=True).start()

# ======== КЛАВИАТУРЫ ========
