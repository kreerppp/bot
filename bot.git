    keyboard = types.InlineKeyboardMarkup(row_width=1)
    upgrades = [
        ("📈 Базовый доход", 1, 100),
        ("📈 Улучшенный доход", 2, 300),
        ("📈 Продвинутый доход", 3, 800),
        ("📈 Экспертный доход", 4, 2000),
