# ======== ОБРАБОТЧИКИ КОМАНД ========
@bot.message_handler(commands=['start'])
def start(message):
    user_id = message.from_user.id
    username = message.from_user.username or "Unknown"
    create_user_if_not_exists(user_id, username)
    
    text = f"""👋 Добро пожаловать в Clicker Game!

🎮 Твой игровой профиль:
💰 Монет: {get_user(user_id)[2] if get_user(user_id) else 0}
👑 Ранг: {get_rank_name(get_user(user_id)[4] if get_user(user_id) else 1)}
💪 Сила клика: {get_click_power(user_id)}
📈 Пассивный доход: {get_passive_income(user_id)} монет/мин

🖱 Кликай, зарабатывай и улучшай своего персонажа!
"""
    bot.send_message(message.chat.id, text, reply_markup=main_keyboard())

@bot.callback_query_handler(func=lambda call: True)
def callback_query(call):
    user_id = call.from_user.id
    username = call.from_user.username or "Unknown"
    create_user_if_not_exists(user_id, username)
    
    # Получаем данные пользователя
    user = get_user(user_id)
    if not user:
        return
    
    # Обработка клика
    if call.data == "click":
        click_power = get_click_power(user_id)
        new_coins = user[2] + click_power
        new_total = user[6] + click_power
        conn = sqlite3.connect('clicker.db', check_same_thread=False)
        cur = conn.cursor()
        cur.execute("UPDATE users SET coins = ?, clicks = clicks + 1, total_coins_earned = ? WHERE user_id = ?", 
                   (new_coins, new_total, user_id))
        conn.commit()
        conn.close()
        
        # Анимация клика
        bot.answer_callback_query(call.id, f"+{click_power} 🪙", show_alert=False)
        bot.edit_message_text(f"🖱 +{click_power} монет!\n💰 Баланс: {new_coins}", 
                             call.message.chat.id, call.message.message_id)
        time.sleep(0.5)
        bot.edit_message_text("Продолжай кликать! 👆", 
                             call.message.chat.id, call.message.message_id)
    
    # Баланс
    elif call.data == "balance":
        user = get_user(user_id)
        income = get_passive_income(user_id)
        text = f"""💰 Твой баланс: {user[2]} монет

📈 Пассивный доход: {income} монет/мин
🖱 Сила клика: {get_click_power(user_id)}
👑 Ранг: {get_rank_name(user[4])}
📊 Всего заработано: {user[6]} монет
🔄 Всего кликов: {user[3]}"""
        bot.edit_message_text(text, call.message.chat.id, call.message.message_id, reply_markup=main_keyboard())
    
    # Магазин
    elif call.data == "shop":
        text = "🏪 Магазин улучшений:\n\nВыбери улучшение для покупки:"
        keyboard = types.InlineKeyboardMarkup(row_width=1)
        upgrades = [
            ("📈 Базовый доход", 1, 100),
            ("📈 Улучшенный доход", 2, 300),
            ("📈 Продвинутый доход", 3, 800),
            ("📈 Экспертный доход", 4, 2000),
            ("💪 Сила клика", 5, 500),
            ("🌟 Легендарный доход", 6, 5000)
        ]
        for name, up_id, cost in upgrades:
            level = get_upgrade_level(user_id, up_id)
            btn = types.InlineKeyboardButton(f"{name} (Ур.{level}) - {cost * (level + 1)}🪙", 
                                            callback_data=f"buy_{up_id}")
            keyboard.add(btn)
        
        btn_back = types.InlineKeyboardButton("🔙 Назад", callback_data="back")
        keyboard.add(btn_back)
        bot.edit_message_text(text, call.message.chat.id, call.message.message_id, reply_markup=keyboard)
    
    # Покупка улучшения
    elif call.data.startswith("buy_"):
        up_id = int(call.data.split("_")[1])
        level = get_upgrade_level(user_id, up_id)
        
        costs = {
            1: 100,
            2: 300,
            3: 800,
            4: 2000,
            5: 500,
            6: 5000
        }
        cost = costs[up_id] * (level + 1)
        
        if user[2] >= cost:
            new_level = level + 1
            update_upgrade(user_id, up_id, new_level)
            
            # Списываем монеты
            conn = sqlite3.connect('clicker.db', check_same_thread=False)
            cur = conn.cursor()
            cur.execute("UPDATE users SET coins = coins - ? WHERE user_id = ?", (cost, user_id))
            conn.commit()
            conn.close()
            
            bot.answer_callback_query(call.id, f"✅ Улучшение куплено! Теперь уровень {new_level}")
            bot.edit_message_text(f"✅ Улучшение повышено до {new_level} уровня!\n💰 Остаток: {user[2] - cost} монет",
                                 call.message.chat.id, call.message.message_id)
            # Обновляем магазин
            time.sleep(1)
            callback_query(call)  # Перезагружаем магазин
        else:
            bot.answer_callback_query(call.id, f"❌ Не хватает монет! Нужно {cost}", show_alert=True)
    
    # Статистика
    elif call.data == "stats":
        user = get_user(user_id)
        income = get_passive_income(user_id)
        text = f"""📊 Твоя статистика:

👤 Имя: @{user[1] if user[1] else 'Unknown'}
🆔 ID: {user_id}
💰 Монет: {user[2]}
🖱 Кликов: {user[3]}
👑 Ранг: {get_rank_name(user[4])}
💪 Сила клика: {get_click_power(user_id)}
📈 Пассивный доход: {income} монет/мин
🏆 Всего заработано: {user[6]} монет

📅 Дата регистрации: {datetime.now().strftime('%d.%m.%Y')}"""
        bot.edit_message_text(text, call.message.chat.id, call.message.message_id, reply_markup=main_keyboard())
    
    # Топ игроков
    elif call.data == "top":
        conn = sqlite3.connect('clicker.db', check_same_thread=False)
        cur = conn.cursor()
        cur.execute("SELECT user_id, username, coins, rank FROM users ORDER BY coins DESC LIMIT 10")
        top_users = cur.fetchall()
        conn.close()
        
        text = "👑 Топ-10 игроков по монетам:\n\n"
        for i, (uid, username, coins, rank) in enumerate(top_users, 1):
            medal = "🥇" if i == 1 else "🥈" if i == 2 else "🥉" if i == 3 else f"{i}."
            text += f"{medal} @{username or 'Unknown'} - {coins}🪙 ({get_rank_name(rank)})\n"
        
        bot.edit_message_text(text, call.message.chat.id, call.message.message_id, reply_markup=main_keyboard())
    
    # Админ-панель
    elif call.data == "admin":
        if user_id != ADMIN_ID:
            bot.answer_callback_query(call.id, "⛔ Доступ запрещен!", show_alert=True)
            return
        text = "👨‍💼 Админ-панель\n\nВыбери действие:"
        bot.edit_message_text(text, call.message.chat.id, call.message.message_id, reply_markup=admin_keyboard())
    
    # Выдача монет (админ)
    elif call.data == "admin_give":
        if user_id != ADMIN_ID:
            bot.answer_callback_query(call.id, "⛔ Доступ запрещен!", show_alert=True)
            return
        msg = bot.send_message(call.message.chat.id, "Введите ID пользователя и количество монет через пробел:\nПример: `123456789 1000`", parse_mode="Markdown")
        bot.register_next_step_handler(msg, admin_give_coins)
    
    # Установка ранга (админ)
    elif call.data == "admin_rank":
        if user_id != ADMIN_ID:
            bot.answer_callback_query(call.id, "⛔ Доступ запрещен!", show_alert=True)
            return
        msg = bot.send_message(call.message.chat.id, "Введите ID пользователя и номер ранга (1-10) через пробел:\nПример: `123456789 5`", parse_mode="Markdown")
        bot.register_next_step_handler(msg, admin_set_rank)
    
    # Рассылка (админ)
    elif call.data == "admin_mail":
        if user_id != ADMIN_ID:
            bot.answer_callback_query(call.id, "⛔ Доступ запрещен!", show_alert=True)
            return
        msg = bot.send_message(call.message.chat.id, "Введите текст для рассылки:")
        bot.register_next_step_handler(msg, admin_mail)
    
    # Статистика бота (админ)
    elif call.data == "admin_stats":
        if user_id != ADMIN_ID:
            bot.answer_callback_query(call.id, "⛔ Доступ запрещен!", show_alert=True)
            return
        conn = sqlite3.connect('clicker.db', check_same_thread=False)
        cur = conn.cursor()
        cur.execute("SELECT COUNT(*) FROM users")
        total_users = cur.fetchone()[0]
        cur.execute("SELECT SUM(coins) FROM users")
        total_coins = cur.fetchone()[0] or 0
        cur.execute("SELECT SUM(clicks) FROM users")
        total_clicks = cur.fetchone()[0] or 0
        conn.close()
        
        text = f"""📊 Статистика бота:

👥 Всего пользователей: {total_users}
💰 Всего монет в системе: {total_coins}
🖱 Всего кликов: {total_clicks}
👑 Максимальный ранг: {get_rank_name(10)}
📈 Пассивный доход: до 600+ монет/мин

🕒 Активен: 24/7"""
        bot.edit_message_text(text, call.message.chat.id, call.message.message_id, reply_markup=admin_keyboard())
    
    # Назад
    elif call.data == "back":
        start(call.message)

# ======== АДМИН-ФУНКЦИИ ========
def admin_give_coins(message):
    try:
        target_id, amount = map(int, message.text.split())
        conn = sqlite3.connect('clicker.db', check_same_thread=False)
        cur = conn.cursor()
        cur.execute("UPDATE users SET coins = coins + ?, total_coins_earned = total_coins_earned + ? WHERE user_id = ?", 
                   (amount, amount, target_id))
        conn.commit()
        conn.close()
        bot.send_message(message.chat.id, f"✅ Пользователю {target_id} выдано {amount} монет!")
    except:
        bot.send_message(message.chat.id, "❌ Ошибка! Введите ID и сумму через пробел.")

def admin_set_rank(message):
    try:
        target_id, rank = map(int, message.text.split())
        if rank < 1 or rank > 10:
            bot.send_message(message.chat.id, "❌ Ранг должен быть от 1 до 10!")
            return
        conn = sqlite3.connect('clicker.db', check_same_thread=False)
        cur = conn.cursor()
        cur.execute("UPDATE users SET rank = ? WHERE user_id = ?", (rank, target_id))
        conn.commit()
        conn.close()
        bot.send_message(message.chat.id, f"✅ Пользователю {target_id} установлен ранг {rank} ({get_rank_name(rank)})!")
    except:
        bot.send_message(message.chat.id, "❌ Ошибка! Введите ID и ранг через пробел.")

def admin_mail(message):
    text = message.text
    conn = sqlite3.connect('clicker.db', check_same_thread=False)
    cur = conn.cursor()
    cur.execute("SELECT user_id FROM users")
    users = cur.fetchall()
    conn.close()
    
    sent = 0
    for user in users:
        try:
            bot.send_message(user[0], f"📢 Администрация бота:\n\n{text}")
            sent += 1
            time.sleep(0.1)  # Чтобы не заблокировали
        except:
            pass
    
    bot.send_message(message.chat.id, f"✅ Рассылка отправлена {sent} пользователям!")

# ======== ЗАПУСК БОТА ========
if __name__ == "__main__":
    print("🤖 Бот запущен!")
    bot.polling(none_stop=True)
