# Обработчики звезд
@dp.callback_query(F.data == "stars")
async def stars_handler(callback: types.CallbackQuery, state: FSMContext):
    await state.set_state(ShopStates.waiting_for_username)
    await callback.message.edit_text(
        "📝 Введите ваш username в shuzagram:"
    )
    await callback.answer()

@dp.message(ShopStates.waiting_for_username)
async def process_stars_username(message: types.Message, state: FSMContext):
    await state.update_data(username=message.text)
    await state.set_state(ShopStates.waiting_for_stars_amount)
    await message.answer(
        "💰 Сколько звезд вы хотите купить?",
        reply_markup=get_stars_keyboard()
    )
@dp.callback_query(F.data.startswith("stars_"))
async def process_stars_amount(callback: types.CallbackQuery, state: FSMContext):
    data = await state.get_data()
    username = data.get('username')
    amount = int(callback.data.split("_")[1])
    price = amount // 100  # Цена в Telegram Stars
    
    await state.clear()
    
    # Отправка счета
    await bot.send_invoice(
        chat_id=callback.from_user.id,
        title="Покупка звезд",
        description=f"Покупка {amount} звезд для пользователя {username}",
        payload=f"stars_{amount}_{username}",
        provider_token="",  # Для Telegram Stars
        currency="XTR",
        prices=[LabeledPrice(label=f"{amount} звезд", amount=price)]
    )
    await callback.message.delete()
    await callback.answer()

# Обработчики NFT
@dp.callback_query(F.data == "nft")
async def nft_handler(callback: types.CallbackQuery, state: FSMContext):
    cursor.execute("SELECT id, name, number, price FROM nfts")
    nfts = cursor.fetchall()
    
    if not nfts:
        await callback.answer("Нет доступных NFT", show_alert=True)
        return
    
    keyboard = []
    for nft in nfts:
        keyboard.append([InlineKeyboardButton(
            text=f"{nft[1]} #{nft[2]} - {nft[3]} ⭐️",
            callback_data=f"select_nft_{nft[0]}"
        )])
    keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="shop")])
    
    await state.set_state(ShopStates.waiting_for_nft_selection)
    await callback.message.edit_text(
        "🎨 Выберите NFT:",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=keyboard)
    )
    await callback.answer()

@dp.callback_query(F.data.startswith("select_nft_"))
async def select_nft_handler(callback: types.CallbackQuery, state: FSMContext):
    nft_id = int(callback.data.split("_")[2])
    cursor.execute("SELECT name, price FROM nfts WHERE id = ?", (nft_id,))
    nft = cursor.fetchone()
    
    if nft:
        await state.update_data(nft_id=nft_id, nft_name=nft[0], nft_price=nft[1])
        await state.set_state(ShopStates.waiting_for_nft_username)
        await callback.message.edit_text(
            "📝 Введите ваш username в shuzagram:"
        )
    await callback.answer()

@dp.message(ShopStates.waiting_for_nft_username)
async def process_nft_username(message: types.Message, state: FSMContext):
    data = await state.get_data()
    username = message.text
    
    await bot.send_invoice(
        chat_id=message.from_user.id,
        title=f"NFT: {data['nft_name']}",
        description=f"Покупка NFT {data['nft_name']} для пользователя {username}",
        payload=f"nft_{data['nft_id']}_{username}",
        provider_token="",
        currency="XTR",
        prices=[LabeledPrice(label=f"NFT {data['nft_name']}", amount=data['nft_price'])]
    )
    await state.clear()

